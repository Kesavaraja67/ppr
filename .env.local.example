DATABASE_URL=postgresql://user:password@ep-something.us-east-2.aws.neon.tech/ppr_db?sslmode=require
ADMIN_JWT_SECRET=change-this-to-a-random-32-char-string-before-deploying
CUSTOMER_JWT_SECRET=change-this-to-another-random-32-char-string
GEMINI_API_KEY=your-gemini-api-key-here
CRON_SECRET=change-this-to-a-random-secret-for-cron-protection
# Firebase client SDK (browser-safe — NEXT_PUBLIC_ prefix required)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key-here
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id-here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
# Firebase Admin SDK — from Firebase Console → Project Settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=your-firebase-project-id-here
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
NEXT_PUBLIC_BASE_URL=http://localhost:3000
